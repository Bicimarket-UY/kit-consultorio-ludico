# Copiar a .env y arrancar con node --env-file=.env src/server.js
PORT=3000
APP_ORIGIN=http://localhost:3000
DATA_DIR=./data
NODE_ENV=development
# Producción: HTTPS público; cookies Secure automáticas con NODE_ENV=production
# Activar solo detrás de un reverse proxy que reescriba X-Forwarded-For y X-Country-Code.
TRUST_PROXY=false
# IP aproximada: opt-in del visitante + esta bandera; comunica IP a ipapi.co.
ENABLE_IP_GEO=false
# SECRETOS solo servidor. No subir .env al repositorio.
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
# Opcional: ID numérico del vendedor, verificado en cada notificación.
MP_COLLECTOR_ID=
